# Copy this file to ".env.local" (that file is never uploaded to GitHub).

# --- Public: these go inside the app. Safe to ship. ---
# Supabase -> Project Settings -> API Keys / Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- SECRET: only for the setup scripts on this computer. ---
# Never put VITE_ in front of these, never share them, never commit them.
# Supabase -> Project Settings -> API Keys -> Secret key (or legacy service_role)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Supabase -> Connect (top bar) -> Session pooler -> URI, with your DB password filled in
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
